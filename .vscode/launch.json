{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ]
    },
    {
      "name": "TypeScript",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run watch"
    }
  ],
  "compounds": [
    {
      "name": "Run all",
      "configurations": [
        "Run Extension",
        "TypeScript"
      ],
      "stopAll": true
    }
  ]
}
