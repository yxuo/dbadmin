.vscode/**
.vscode-test/**
src/**
docs/**
scripts/**
local_dev/**
.github/**
.git/**
.gitignore
.reasonix/**
.cursor/**
agent-transcripts/**
*.vsix
*.tsbuildinfo
package-lock.json
tmp-*.js

# Build artifacts not needed at runtime
**/*.map
**/*.ts
**/tsconfig.json
**/*.d.ts
**/*.d.cts
**/*.d.mts

# Dependency junk (vsce still packs production packages)
**/test/**
**/tests/**
**/__tests/**
**/*.md
!README.md
!CHANGELOG.md
**/*.markdown
**/.github/**
**/docs/**
**/example/**
**/examples/**
**/coverage/**
node_modules/**/LICENSE*

# @vscode/codicons: only the webview CSS + font are used
node_modules/@vscode/codicons/.devcontainer/**
node_modules/@vscode/codicons/.husky/**
node_modules/@vscode/codicons/.vscode/**
node_modules/@vscode/codicons/_iconCloud/**
node_modules/@vscode/codicons/build/**
node_modules/@vscode/codicons/scripts/**
node_modules/@vscode/codicons/src/**
node_modules/@vscode/codicons/dist/codicon.html
node_modules/@vscode/codicons/dist/codicon.csv
node_modules/@vscode/codicons/dist/codicon.svg
node_modules/@vscode/codicons/dist/metadata.json
node_modules/@vscode/codicons/preview.png
node_modules/@vscode/codicons/.fantasticonrc.js
node_modules/@vscode/codicons/svgo.config.js

# SQLite uses only the Node WASM loader; the WASM binary is copied to resources.
node_modules/sql.js/dist/*.zip
node_modules/sql.js/dist/sql-asm*
node_modules/sql.js/dist/worker.sql-*
node_modules/sql.js/dist/*-debug*
node_modules/sql.js/dist/*-browser*
node_modules/sql.js/dist/sql-wasm.wasm
