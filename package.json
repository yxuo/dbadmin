    "languages": [
      {
        "id": "sql",
        "extensions": [
          ".sql"
        ],
        "aliases": [
          "SQL",
          "sql"
        ]
      },
      {
        "id": "sqlbook",
        "extensions": [
          ".sqlbook"
        ],
        "aliases": [
          "SQL Book",
          "sqlbook"
        ]
      }
    ],
    "configurationDefaults": {
      "vsicons.associations.files": [
        {
          "icon": "sql",
          "extensions": [
            "sqlbook"
          ],
          "languages": [
            {
              "ids": "sqlbook",
              "defaultExtension": "sqlbook"
            }
          ],
          "format": "svg"
        }
      ],
      "material-icon-theme.files.associations": {
        "*.sqlbook": "sql"
      }
    },
    "notebooks": [
      {
        "type": "sqlbook",
        "displayName": "%dbadmin.notebook.sqlbook%",
        "selector": [
          {
            "filenamePattern": "*.sqlbook"
          }
        ]
      }
    ],
    "notebookRenderer": [
      {
        "id": "dbadmin-sqlbook-table",
        "displayName": "%dbadmin.notebookRenderer.sqlbookTable%",
        "entrypoint": "./resources/sqlBookTableRenderer.js",
        "mimeTypes": [
          "application/vnd.dbadmin.sqlbook-table+json"
        ],
        "requiresMessaging": "optional"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "dbadmin",
        "label": "%dbadmin.mcpProvider.label%"
      }
    ],
    "keybindings": [
      {
        "command": "dbadmin.executeSqlFromActiveEditor",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "dbadmin.toggleSqlBookIntegratedTable",
          "when": "notebookType == 'sqlbook' && config.dbadmin.sqlbookIntegratedTable != true && dbadmin.sqlbookIntegratedTable != true",
          "group": "notebookLayout@35"
        },
        {
          "command": "dbadmin.toggleSqlBookIntegratedTableChecked",
          "when": "notebookType == 'sqlbook' && (config.dbadmin.sqlbookIntegratedTable == true || dbadmin.sqlbookIntegratedTable == true)",
          "group": "notebookLayout@35"
        },
        {
          "command": "dbadmin.toggleSqlBookSaveIntegratedTable",
          "when": "notebookType == 'sqlbook' && dbadmin.sqlbookSaveIntegratedTable != true",
          "group": "notebookLayout@36"
        },
        {
          "command": "dbadmin.toggleSqlBookSaveIntegratedTableChecked",
          "when": "notebookType == 'sqlbook' && dbadmin.sqlbookSaveIntegratedTable == true",
          "group": "notebookLayout@36"
        },
        {
          "command": "dbadmin.toggleSqlBookRunPerQuery",
          "when": "notebookType == 'sqlbook' && config.dbadmin.sqlbookRunPerQuery != true && dbadmin.sqlbookRunPerQuery != true",
          "group": "notebookLayout@37"
        },
        {
          "command": "dbadmin.toggleSqlBookRunPerQueryChecked",
          "when": "notebookType == 'sqlbook' && (config.dbadmin.sqlbookRunPerQuery == true || dbadmin.sqlbookRunPerQuery == true)",
          "group": "notebookLayout@37"
        }
      ],
      "editor/title": [
        {
          "command": "dbadmin.toggleSqlBookRunPerQuery",
          "when": "resourceLangId == sql && notebookType != 'sqlbook' && config.dbadmin.sqlbookRunPerQuery != true && dbadmin.sqlbookRunPerQuery != true",
          "group": "1_dbadmin@1"
        },
        {
          "command": "dbadmin.toggleSqlBookRunPerQueryChecked",
          "when": "resourceLangId == sql && notebookType != 'sqlbook' && (config.dbadmin.sqlbookRunPerQuery == true || dbadmin.sqlbookRunPerQuery == true)",
          "group": "1_dbadmin@1"
        }
      ],
      "commandPalette": [
        {
          "command": "dbadmin.toggleSqlBookIntegratedTableChecked",
          "when": "false"
        },
        {
          "command": "dbadmin.toggleSqlBookSaveIntegratedTableChecked",
          "when": "false"
        },
        {
          "command": "dbadmin.toggleSqlBookRunPerQueryChecked",
          "when": "false"
        },
        {
          "command": "dbadmin.executeSqlBookStatement",
          "when": "false"
        },
        {
          "command": "dbadmin.executeSqlRunnerStatement",
          "when": "false"
        }
      ],
      "view/title": [
