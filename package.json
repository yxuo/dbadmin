{
  "name": "dbadmin",
  "displayName": "DBAdmin",
  "description": "Database manager for VS Code.",
  "version": "0.0.1",
  "publisher": "yxuo",
  "repository": {
    "type": "git",
    "url": "https://github.com/yxuo/database-vscode.git"
  },
  "icon": "resources/icons/extension.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "DBAdmin",
        "properties": {
          "dbadmin.showQueryEditor": {
            "type": "boolean",
            "default": true,
            "description": "Mostrar o editor de query na visualização de tabela."
          },
          "dbadmin.hideTabHeader": {
            "type": "boolean",
            "default": false,
            "description": "Ocultar o cabeçalho do painel de abas da tabela e mover o botão de menu para a toolbar."
          },
          "dbadmin.persistColumnLayout": {
            "type": "boolean",
            "default": false,
            "description": "Persistir ocultação, ordem e largura de colunas mesmo fora da restauração automática de abas."
          },
          "dbadmin.pgAdminBinPath": {
            "type": "string",
            "default": "",
            "description": "Caminho para o diretório dos binários do pgAdmin (pg_dump, pg_restore). Deixe vazio para detectar automaticamente."
          },
          "dbadmin.showFilterLabel": {
            "type": "boolean",
            "default": true,
            "description": "Mostrar o label do filtro no topo do DBAdmin quando houver filtro ativo."
          },
          "dbadmin.defaultPageSize": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 500,
            "scope": "window",
            "order": 50,
            "description": "Número padrão de itens por página na visualização de tabela."
          },
          "dbadmin.dynamicDefaultColumnWidth": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "order": 51,
            "description": "Quando ativo, calcula a largura padrão das colunas de forma dinâmica com base no conteúdo visível. Quando desativado, usa largura fixa (170)."
          },
          "dbadmin.expandFilterResults": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "order": 52,
            "description": "Quando ativo, ao digitar no filtro de tabelas recolhe e expande automaticamente os resultados na árvore."
          }
        }
      },
      {
        "title": "SQLBook",
        "properties": {
          "dbadmin.sqlbookIntegratedTable": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "description": "Mostrar tabela integrada no SQL Book (resultado inline na célula em vez de abrir o painel)."
          },
          "dbadmin.sqlbookRunPerQuery": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "description": "Mostrar um botão Executar em cada query quando a célula do SQL Book tiver duas ou mais instruções (separadas por ponto e vírgula ou linha em branco)."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbadmin",
          "title": "DBAdmin",
          "icon": "resources/icons/extension.svg"
        }
      ]
    },
    "views": {
      "dbadmin": [
        {
          "id": "databaseExplorer",
          "name": "DBAdmin",
          "icon": "resources/icons/extension.svg",
          "order": 1
        },
        {
          "id": "databaseExplorerFilter",
          "name": "Filtro de tabelas",
          "icon": "resources/icons/extension.svg",
          "type": "webview",
          "order": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "databaseExplorer",
        "contents": "Sem provedor de dados."
      }
    ],
    "commands": [
      {
        "command": "dbadmin.createConnection",
        "title": "Criar Conexão",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.editConnection",
        "title": "Editar Conexão",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.deleteConnection",
        "title": "Excluir Conexão",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.refresh",
        "title": "Atualizar",
        "icon": "$(refresh)"
      },
      {
        "command": "dbadmin.collapseAllExplorer",
        "title": "Recolher tudo",
        "icon": "$(collapse-all)",
        "enablement": "dbadmin.hasExpandedTreeItems"
      },
      {
        "command": "dbadmin.refreshConnection",
        "title": "Atualizar Conexão",
        "icon": "$(refresh)"
      },
      {
        "command": "dbadmin.refreshDatabase",
        "title": "Atualizar Banco de Dados",
        "icon": "$(refresh)"
      },
      {
        "command": "dbadmin.refreshSchema",
        "title": "Atualizar Schema",
        "icon": "$(refresh)"
      },
      {
        "command": "dbadmin.openSettings",
        "title": "Configurações",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dbadmin.openTable",
        "title": "Abrir Tabela"
      },
      {
        "command": "dbadmin.openTableInNewTab",
        "title": "Abrir em nova aba",
        "icon": "$(diff-renamed)"
      },
      {
        "command": "dbadmin.truncateTable",
        "title": "Esvaziar tabela",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.createDatabase",
        "title": "Criar",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.renameDatabase",
        "title": "Renomear",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.duplicateDatabase",
        "title": "Duplicar",
        "icon": "$(copy)"
      },
      {
        "command": "dbadmin.dropDatabase",
        "title": "Excluir",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.backupSchema",
        "title": "Backup",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dbadmin.restoreSchema",
        "title": "Restaurar",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dbadmin.clearSchema",
        "title": "Limpar schema",
        "icon": "$(clear-all)"
      },
      {
        "command": "dbadmin.createSchema",
        "title": "Criar",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.createFunction",
        "title": "Criar function",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.editFunction",
        "title": "Editar function",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.deleteFunction",
        "title": "Excluir function",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.createProcedure",
        "title": "Criar procedure",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.editProcedure",
        "title": "Editar procedure",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.deleteProcedure",
        "title": "Excluir procedure",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.createTrigger",
        "title": "Criar trigger",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.editTrigger",
        "title": "Editar trigger",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.deleteTrigger",
        "title": "Excluir trigger",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.dropSchema",
        "title": "Excluir schema",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.openColumnDetails",
        "title": "Abrir detalhes da coluna"
      },
      {
        "command": "dbadmin.openConstraintDetails",
        "title": "Abrir detalhes da restrição"
      },
      {
        "command": "dbadmin.openColumnDetailsInNewTab",
        "title": "Abrir em nova aba",
        "icon": "$(diff-renamed)"
      },
      {
        "command": "dbadmin.openConstraintDetailsInNewTab",
        "title": "Abrir em nova aba",
        "icon": "$(diff-renamed)"
      },
      {
        "command": "dbadmin.editTableFilter",
        "title": "Filtrar tabelas",
        "icon": "$(search)"
      },
      {
        "command": "dbadmin.clearTableFilter",
        "title": "Limpar filtro de tabelas",
        "icon": "$(close)"
      },
      {
        "command": "dbadmin.spacer",
        "title": "Espaçador",
        "icon": "$(blank)"
      },
      {
        "command": "dbadmin.expandNode",
        "title": "Expandir",
        "icon": "$(expand-all)"
      },
      {
        "command": "dbadmin.executeSqlFromActiveEditor",
        "title": "Executar SQL do Editor Ativo",
        "icon": "$(play)"
      },
      {
        "command": "dbadmin.sqlRunner.selectConnection",
        "title": "SQL Runner: Selecionar Conexão"
      },
      {
        "command": "dbadmin.sqlRunner.selectDatabase",
        "title": "SQL Runner: Selecionar Banco"
      },
      {
        "command": "dbadmin.sqlRunner.selectSchema",
        "title": "SQL Runner: Selecionar Schema"
      },
      {
        "command": "dbadmin.toggleSqlBookIntegratedTable",
        "title": "Mostrar tabela integrada",
        "category": "DBAdmin"
      },
      {
        "command": "dbadmin.toggleSqlBookIntegratedTableChecked",
        "title": "✓ Mostrar tabela integrada",
        "category": "DBAdmin",
        "icon": "$(check)"
      },
      {
        "command": "dbadmin.toggleSqlBookRunPerQuery",
        "title": "Botão executar por query",
        "category": "DBAdmin"
      },
      {
        "command": "dbadmin.toggleSqlBookRunPerQueryChecked",
        "title": "✓ Botão executar por query",
        "category": "DBAdmin",
        "icon": "$(check)"
      },
      {
        "command": "dbadmin.executeSqlBookStatement",
        "title": "Executar query do SQL Book",
        "category": "DBAdmin"
      },
      {
        "command": "dbadmin.openLastSqlBookResult",
        "title": "Abrir último resultado do SQL Book",
        "category": "DBAdmin"
      }
    ],
    "languages": [
      {
        "id": "sql",
        "extensions": [
          ".sql"
        ],
        "aliases": [
          "SQL",
          "sql"
        ]
      },
      {
        "id": "sqlbook",
        "extensions": [
          ".sqlbook"
        ],
        "aliases": [
          "SQL Book",
          "sqlbook"
        ]
      }
    ],
    "configurationDefaults": {
      "vsicons.associations.files": [
        {
          "icon": "sql",
          "extensions": [
            "sqlbook"
          ],
          "languages": [
            {
              "ids": "sqlbook",
              "defaultExtension": "sqlbook"
            }
          ],
          "format": "svg"
        }
      ],
      "material-icon-theme.files.associations": {
        "*.sqlbook": "sql"
      }
    },
    "notebooks": [
      {
        "type": "sqlbook",
        "displayName": "DBAdmin SQL Book",
        "selector": [
          {
            "filenamePattern": "*.sqlbook"
          }
        ]
      }
    ],
    "notebookRenderer": [
      {
        "id": "dbadmin-sqlbook-table",
        "displayName": "DBAdmin SQL Book Table",
        "entrypoint": "./resources/sqlBookTableRenderer.js",
        "mimeTypes": [
          "application/vnd.dbadmin.sqlbook-table+json"
        ],
        "requiresMessaging": "optional"
      }
    ],
    "keybindings": [
      {
        "command": "dbadmin.executeSqlFromActiveEditor",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "dbadmin.toggleSqlBookIntegratedTable",
          "when": "notebookType == 'sqlbook' && config.dbadmin.sqlbookIntegratedTable != true && dbadmin.sqlbookIntegratedTable != true",
          "group": "notebookLayout@35"
        },
        {
          "command": "dbadmin.toggleSqlBookIntegratedTableChecked",
          "when": "notebookType == 'sqlbook' && (config.dbadmin.sqlbookIntegratedTable == true || dbadmin.sqlbookIntegratedTable == true)",
          "group": "notebookLayout@35"
        },
        {
          "command": "dbadmin.toggleSqlBookRunPerQuery",
          "when": "notebookType == 'sqlbook' && config.dbadmin.sqlbookRunPerQuery != true && dbadmin.sqlbookRunPerQuery != true",
          "group": "notebookLayout@36"
        },
        {
          "command": "dbadmin.toggleSqlBookRunPerQueryChecked",
          "when": "notebookType == 'sqlbook' && (config.dbadmin.sqlbookRunPerQuery == true || dbadmin.sqlbookRunPerQuery == true)",
          "group": "notebookLayout@36"
        }
      ],
      "commandPalette": [
        {
          "command": "dbadmin.toggleSqlBookIntegratedTableChecked",
          "when": "false"
        },
        {
          "command": "dbadmin.toggleSqlBookRunPerQueryChecked",
          "when": "false"
        },
        {
          "command": "dbadmin.executeSqlBookStatement",
          "when": "false"
        }
      ],
