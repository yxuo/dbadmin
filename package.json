{
  "name": "dbadmin",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "yxuo",
  "repository": {
    "type": "git",
    "url": "https://github.com/yxuo/database-vscode.git"
  },
  "icon": "resources/icons/extension.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:dbadmin.tableData",
    "onWebviewPanel:dbadmin.settings",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "%dbadmin.config.title%",
        "properties": {
          "dbadmin.persistColumnLayout": {
            "type": "boolean",
            "default": false,
            "description": "%dbadmin.config.persistColumnLayout%"
          },
          "dbadmin.pgAdminBinPath": {
            "type": "string",
            "default": "",
            "description": "%dbadmin.config.pgAdminBinPath%"
          },
          "dbadmin.showFilterLabel": {
            "type": "boolean",
            "default": true,
            "description": "%dbadmin.config.showFilterLabel%"
          },
          "dbadmin.defaultPageSize": {
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 500,
            "scope": "window",
            "order": 50,
            "description": "%dbadmin.config.defaultPageSize%"
          },
          "dbadmin.managerPollIntervalSeconds": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 60,
            "scope": "window",
            "order": 53,
            "description": "%dbadmin.config.managerPollIntervalSeconds%"
          },
          "dbadmin.managerTimeWindowMinutes": {
            "type": "integer",
            "default": 2,
            "minimum": 0,
            "maximum": 1440,
            "scope": "window",
            "order": 54,
            "description": "%dbadmin.config.managerTimeWindowMinutes%"
          },
          "dbadmin.dynamicDefaultColumnWidth": {
            "type": "boolean",
            "default": true,
            "scope": "window",
            "order": 51,
            "description": "%dbadmin.config.dynamicDefaultColumnWidth%"
          },
          "dbadmin.expandFilterResults": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "order": 52,
            "description": "%dbadmin.config.expandFilterResults%"
          },
          "dbadmin.mcpAllowWrites": {
            "type": "boolean",
            "default": false,
            "scope": "window",
            "order": 60,
            "description": "%dbadmin.config.mcpAllowWrites%"
          },
          "dbadmin.mcpMaxRows": {
            "type": "integer",
            "default": 200,
            "minimum": 1,
            "maximum": 5000,
            "scope": "window",
            "order": 61,
            "description": "%dbadmin.config.mcpMaxRows%"
          }
        }
      },
      {
        "title": "%dbadmin.config.sqlbook.title%",
        "properties": {
          "dbadmin.sqlbookIntegratedTable": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "description": "%dbadmin.config.sqlbookIntegratedTable%"
          },
          "dbadmin.sqlbookSaveIntegratedTable": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "%dbadmin.config.sqlbookSaveIntegratedTable%"
          },
          "dbadmin.sqlbookRunPerQuery": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "description": "%dbadmin.config.sqlbookRunPerQuery%"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbadmin",
          "title": "%dbadmin.view.explorer%",
          "icon": "resources/icons/extension.svg"
        }
      ]
    },
    "views": {
      "dbadmin": [
        {
          "id": "databaseExplorer",
          "name": "%dbadmin.view.explorer%",
          "icon": "resources/icons/extension.svg",
          "order": 1
        },
        {
          "id": "databaseExplorerFilter",
          "name": "%dbadmin.view.filter%",
          "icon": "resources/icons/extension.svg",
          "type": "webview",
          "order": 2,
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "databaseExplorer",
        "contents": "%dbadmin.viewsWelcome%"
      }
    ],
    "commands": [
      {
        "command": "dbadmin.createConnection",
        "title": "%dbadmin.command.createConnection%",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.openConnectionManager",
        "title": "%dbadmin.command.openConnectionManager%",
        "category": "DBAdmin",
        "icon": "$(settings)"
      },
      {
        "command": "dbadmin.editConnection",
