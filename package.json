{
  "name": "dbadmin",
  "displayName": "DBAdmin",
  "description": "Database manager for VS Code.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "DBAdmin",
      "properties": {
        "dbadmin.showQueryEditor": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar o editor de query na visualização de tabela."
        },
        "dbadmin.hideTabHeader": {
          "type": "boolean",
          "default": false,
          "description": "Ocultar o cabeçalho do painel de abas da tabela e mover o botão de menu para a toolbar."
        },
        "dbadmin.persistColumnLayout": {
          "type": "boolean",
          "default": false,
          "description": "Persistir ocultação, ordem e largura de colunas mesmo fora da restauração automática de abas."
        },
        "dbadmin.pgAdminBinPath": {
          "type": "string",
          "default": "",
          "description": "Caminho para o diretório dos binários do pgAdmin (pg_dump, pg_restore). Deixe vazio para detectar automaticamente."
        },
        "dbadmin.showFilterLabel": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar o label do filtro no topo do DBAdmin quando houver filtro ativo."
        },
        "dbadmin.defaultPageSize": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "scope": "window",
          "order": 50,
          "description": "Número padrão de itens por página na visualização de tabela."
        },
        "dbadmin.nativePreviewMatchColumnType": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "order": 51,
          "description": "Quando ativo, a prévia nativa usa .json para colunas JSON e .txt para as demais. Quando desativado, usa sempre .json."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbadmin",
          "title": "DBAdmin",
          "icon": "resources/icons/database.svg"
        }
      ]
    },
    "views": {
      "dbadmin": [
        {
          "id": "databaseExplorer",
          "name": "DBAdmin",
          "icon": "resources/icons/database.svg",
          "order": 1
        },
        {
          "id": "databaseExplorerFilter",
          "name": "Filtro de tabelas",
          "icon": "resources/icons/database.svg",
          "type": "webview",
          "order": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "databaseExplorer",
        "contents": "Sem provedor de dados."
      }
    ],
    "commands": [
      {
        "command": "dbadmin.createConnection",
        "title": "Create Connection",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.editConnection",
        "title": "Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.deleteConnection",
        "title": "Delete Connection",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dbadmin.openSettings",
        "title": "Configurações",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dbadmin.openTable",
        "title": "Abrir Tabela"
      },
      {
        "command": "dbadmin.openTableInNewTab",
        "title": "Abrir em nova aba",
        "icon": "$(diff-renamed)"
      },
      {
        "command": "dbadmin.createDatabase",
        "title": "Criar banco de dados",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.renameDatabase",
        "title": "Renomear banco de dados",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.dropDatabase",
        "title": "Excluir banco de dados",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.backupSchema",
        "title": "Backup do schema",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dbadmin.restoreSchema",
        "title": "Restaurar schema",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "dbadmin.openColumnDetails",
        "title": "Abrir detalhes da coluna"
      },
      {
        "command": "dbadmin.openConstraintDetails",
        "title": "Abrir detalhes da restrição"
      },
      {
        "command": "dbadmin.openColumnDetailsInNewTab",
        "title": "Abrir em nova aba",
        "icon": "$(diff-renamed)"
      },
      {
        "command": "dbadmin.openConstraintDetailsInNewTab",
        "title": "Abrir em nova aba",
        "icon": "$(diff-renamed)"
      },
      {
        "command": "dbadmin.editTableFilter",
        "title": "Filtrar tabelas",
        "icon": "$(search)"
      },
      {
        "command": "dbadmin.clearTableFilter",
        "title": "Limpar filtro de tabelas",
        "icon": "$(close)"
      },
      {
        "command": "dbadmin.spacer",
        "title": "Espaçador",
        "icon": "$(blank)"
      }
    ],
    "menus": {
      "view/title": [
        {
            "command": "dbadmin.openSettings",
            "when": "view == databaseExplorer",
            "group": "navigation"
        },
        {
          "command": "dbadmin.createConnection",
          "when": "view == databaseExplorer",
          "group": "navigation@1"
        },
        {
          "command": "dbadmin.refresh",
          "when": "view == databaseExplorer",
          "group": "navigation@2"
        },
        {
          "command": "dbadmin.editTableFilter",
          "when": "view == databaseExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dbadmin.editConnection",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dbadmin.deleteConnection",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "dbadmin.openTableInNewTab",
          "when": "view == databaseExplorer && viewItem == dbObject:table",
          "group": "inline"
        },
        {
          "command": "dbadmin.spacer",
          "when": "view == databaseExplorer && viewItem == dbObject:table",
          "group": "inline@999"
        },
        {
          "command": "dbadmin.openTableInNewTab",
          "when": "view == databaseExplorer && viewItem == dbObject:table",
          "group": "navigation"
        },
        {
          "command": "dbadmin.createDatabase",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "inline@2"
        },
        {
          "command": "dbadmin.createDatabase",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "navigation"
        },
        {
          "command": "dbadmin.renameDatabase",
          "when": "view == databaseExplorer && viewItem == database",
          "group": "navigation"
        },
        {
          "command": "dbadmin.dropDatabase",
          "when": "view == databaseExplorer && viewItem == database",
          "group": "navigation@1"
        },
        {
          "command": "dbadmin.backupSchema",
          "when": "view == databaseExplorer && viewItem == schema",
          "group": "navigation"
        },
        {
          "command": "dbadmin.restoreSchema",
          "when": "view == databaseExplorer && viewItem == schema",
          "group": "navigation@1"
        },
        {
          "command": "dbadmin.openColumnDetailsInNewTab",
          "when": "view == databaseExplorer && viewItem == tableSectionItem:column",
          "group": "inline"
        },
        {
          "command": "dbadmin.spacer",
          "when": "view == databaseExplorer && viewItem == tableSectionItem:column",
          "group": "inline@999"
        },
        {
          "command": "dbadmin.openConstraintDetailsInNewTab",
          "when": "view == databaseExplorer && viewItem == tableSectionItem:constraint",
          "group": "inline"
        },
        {
          "command": "dbadmin.spacer",
          "when": "view == databaseExplorer && viewItem == tableSectionItem:constraint",
          "group": "inline@999"
        },
        {
          "command": "dbadmin.clearTableFilter",
          "when": "view == databaseExplorer && viewItem == filterControl",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "echo \"No lint configured\"",
    "test": "echo \"No tests configured\""
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.20.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
