        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.deleteConnection",
        "title": "%dbadmin.command.deleteConnection%",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.refresh",
        "title": "%dbadmin.command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbadmin.collapseAllExplorer",
