{
  "name": "dbadmin",
  "displayName": "DBAdmin",
  "description": "Database manager for VS Code.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbadmin",
          "title": "DBAdmin",
          "icon": "resources/icons/database.svg"
        }
      ]
    },
    "views": {
      "dbadmin": [
        {
          "id": "databaseExplorer",
          "name": "DBAdmin",
          "icon": "resources/icons/database.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "databaseExplorer",
        "contents": "Sem provedor de dados."
      }
    ],
    "commands": [
      {
        "command": "dbadmin.createConnection",
        "title": "Create Connection",
        "icon": "$(add)"
      },
      {
        "command": "dbadmin.editConnection",
        "title": "Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "dbadmin.deleteConnection",
        "title": "Delete Connection",
        "icon": "$(trash)"
      },
      {
        "command": "dbadmin.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dbadmin.openSettings",
        "title": "Configurações",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dbadmin.openTable",
        "title": "Abrir Tabela"
      },
      {
        "command": "dbadmin.openTableInNewTab",
        "title": "Abrir em nova aba",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbadmin.createConnection",
          "when": "view == databaseExplorer",
          "group": "navigation"
        },
        {
          "command": "dbadmin.refresh",
          "when": "view == databaseExplorer",
          "group": "navigation@1"
        },
        {
          "command": "dbadmin.openSettings",
          "when": "view == databaseExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dbadmin.editConnection",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dbadmin.deleteConnection",
          "when": "view == databaseExplorer && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "dbadmin.openTableInNewTab",
          "when": "view == databaseExplorer && viewItem == dbObject:table",
          "group": "inline"
        },
        {
          "command": "dbadmin.openTableInNewTab",
          "when": "view == databaseExplorer && viewItem == dbObject:table",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "echo \"No lint configured\"",
    "test": "echo \"No tests configured\""
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/pg": "^8.20.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
